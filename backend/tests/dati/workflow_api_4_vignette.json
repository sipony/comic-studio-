      "image": ["3", 0],
      "weight": 0.75,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt negativo (comune)"},
