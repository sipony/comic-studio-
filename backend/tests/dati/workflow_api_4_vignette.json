{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Modello SDXL (cambia con il tuo)"},
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": {"title": "Immagine di riferimento del personaggio"},
    "inputs": {"image": "personaggio.png"}
  },
  "3": {
    "class_type": "PrepImageForClipVision",
    "_meta": {"title": "Prepara riferimento"},
    "inputs": {
      "image": ["2", 0],
      "interpolation": "LANCZOS",
      "crop_position": "top",
      "sharpening": 0.0
    }
  },
  "4": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": {"title": "IPAdapter loader"},
    "inputs": {
      "model": ["1", 0],
      "preset": "PLUS (high strength)"
    }
  },
  "5": {
    "class_type": "IPAdapterAdvanced",
    "_meta": {"title": "Coerenza personaggio (weight 0.6-0.85)"},
